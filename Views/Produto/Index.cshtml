@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CadastroDeProdutos.Models.Produto

<h1>Cadastro de Produto</h1>

<form asp-controller="Produto" asp-action="Cadastrar" method="post">

    <label>Nome:</label>
    <input type="text" asp-for="Nome"/>

    <br><br>

    <label>Preço:</label>
    <input type="number" step="0.01" asp-for="Preco"/>

    <br><br>

    <label>Quantidade:</label>
    <input type="number" asp-for="Quantidade"/>

    <br><br>

    <label>Imagem:</label>
    <input type="text" asp-for="Imagem"/>

    <br><br>

    <label>Vídeo:</label>
    <input type="text" asp-for="Video"/>

    <br><br>

    <button type="submit">
        Cadatrar Produto
    </button>

</form>